{
  "manifest_version": 3,
  "name": "Luma per Tapo 2.1",
  "version": "2.1.1",
  "description": "Le tue luci Tapo, nelle tue stanze, direttamente da Chrome.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Luma per Tapo",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
