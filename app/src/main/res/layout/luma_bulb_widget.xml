<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_luma_widget_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Header Row: Brand / Room + Status Pill + Switch Device -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_open_app_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:singleLine="true"
                android:text="LUMA · CASA"
                android:textAllCaps="true"
                android:textColor="#9991A1"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Lampadina Tapo"
                android:textColor="#302B3A"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Cycle next bulb button (shown when >1 bulb) -->
        <TextView
            android:id="@+id/widget_btn_next_device"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_luma_widget_pill"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Cambia ↻"
            android:textColor="#735A7B"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <!-- Status badge -->
        <LinearLayout
            android:id="@+id/widget_status_pill"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_luma_widget_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingEnd="9dp">

            <ImageView
                android:id="@+id/widget_status_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:contentDescription="@null"
                android:src="@drawable/bg_luma_status_dot" />

            <TextView
                android:id="@+id/widget_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:singleLine="true"
                android:text="Pronta"
                android:textColor="#777083"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Middle Row: Bulb Orb + State Info + Power Toggle + Brightness -/+ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Bulb color indicator box -->
        <FrameLayout
            android:id="@+id/widget_bulb_badge"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_luma_widget_power_on">

            <ImageView
                android:id="@+id/widget_bulb_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_bulb" />
        </FrameLayout>

        <!-- Brightness & Mode Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_state_headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="Accesa · 72%"
                android:textColor="#302B3A"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_state_subline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="Bianco caldo · 3200 K"
                android:textColor="#7F7482"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Brightness -20% -->
        <TextView
            android:id="@+id/widget_btn_bri_down"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_luma_widget_pill"
            android:gravity="center"
            android:text="−"
            android:textColor="#302B3A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Brightness +20% -->
        <TextView
            android:id="@+id/widget_btn_bri_up"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_luma_widget_pill"
            android:gravity="center"
            android:text="+"
            android:textColor="#302B3A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Power Toggle Button -->
        <LinearLayout
            android:id="@+id/widget_btn_power"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_luma_widget_power_on"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="13dp"
            android:paddingEnd="13dp">

            <ImageView
                android:id="@+id/widget_power_icon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_power" />

            <TextView
                android:id="@+id/widget_power_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="Spegni"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Row: 4 Quick Atmosphere Scene Pills -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_scene_relax"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_luma_widget_pill"
            android:gravity="center"
            android:singleLine="true"
            android:text="Relax"
            android:textColor="#735A7B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_scene_focus"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_luma_widget_pill"
            android:gravity="center"
            android:singleLine="true"
            android:text="Studio"
            android:textColor="#735A7B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_scene_sunset"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_luma_widget_pill"
            android:gravity="center"
            android:singleLine="true"
            android:text="Tramonto"
            android:textColor="#735A7B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_scene_dream"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/bg_luma_widget_pill"
            android:gravity="center"
            android:singleLine="true"
            android:text="Sogno"
            android:textColor="#735A7B"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
